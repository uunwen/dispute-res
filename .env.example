# Postgres (async driver for SQLAlchemy)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/dispute_resolver

# Redis
REDIS_URL=redis://localhost:6379/0

# LLM (OpenAI-compatible API — Gemini)
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash

# Per-agent model overrides (empty = default to LLM_MODEL).
# Thinking models are slower and consume quota faster — use them only where needed.
LLM_MODEL_ADVOCATE=
LLM_MODEL_JUDGE=
LLM_MODEL_TOOLS=

# Embeddings (leave EMBEDDING_API_KEY empty to use the local fastembed model)
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=

# Escalation to human review
ESCALATION_ENABLED=true
ESCALATION_THRESHOLD=0.65
