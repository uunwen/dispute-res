# Postgres (async driver for SQLAlchemy)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/dispute_resolver

# Redis
REDIS_URL=redis://localhost:6379/0

# LLM (OpenAI-compatible API — Gemini)
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash

# Per-agent model overrides (empty = default to LLM_MODEL).
# Thinking models are slower and consume quota faster — use them only where needed.
LLM_MODEL_ADVOCATE=
LLM_MODEL_JUDGE=
LLM_MODEL_TOOLS=

# LLM behaviour
LLM_MOCK=false
LLM_TIMEOUT=60.0
LLM_MAX_RETRIES=3
LLM_TEMPERATURE=0.0
# Cap the number of LLM tool-calling rounds an advocate may perform.
ADVOCATE_MAX_TOOL_CALLS=2
# Run a second rebuttal round between the two advocates.
REBUTTAL_ENABLED=true

# Embeddings (leave EMBEDDING_API_KEY empty to use the local fastembed model)
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
# Single source of truth for the embedding space; must stay <= 2000 for pgvector.
EMBEDDING_DIM=384
FASTEMBED_MODEL=BAAI/bge-small-en-v1.5
# Minimum cosine similarity for a retrieved policy chunk to be returned.
EMBEDDING_SIMILARITY_CUTOFF=0.25

# Escalation to human review (Policy v2.1)
ESCALATION_ENABLED=true
# Sec 6.1 monetary thresholds (disputed amount = actual fare):
# below ESCALATION_LOW_VALUE -> final at any confidence; between low and high
# -> confidence threshold applies; above high -> always escalate.
ESCALATION_LOW_VALUE=10.0
ESCALATION_HIGH_VALUE=50.0
# Sec 6.1: confidence threshold for the $10-50 band (also used for route
# deviation regardless of amount, Sec 6.2).
ESCALATION_THRESHOLD=0.80
# Sec 6.3: raised threshold when a party has a fraud flag.
ESCALATION_FRAUD_THRESHOLD=0.95
# Sec 6.2: escalate route deviations beyond this distance.
ROUTE_ESCALATE_KM=2.0
# Sec 5.2: safety terms that force escalation regardless of the selected category.
# SAFETY_KEYWORDS=["threat", "threaten", "harass", "assault", "abuse", "dangerous", "reckless", "unsafe", "sexual", "inappropriate", "emergency", "sos", "weapon", "violence", "scared", "fear", "hurt", "attack"]

# Fraud detection thresholds
FRAUD_DISPUTE_FREQUENCY_DAYS=30
FRAUD_DISPUTE_FREQUENCY_THRESHOLD=3
FRAUD_WIN_RATE_THRESHOLD=0.4
FRAUD_REPEAT_DEVIATION_THRESHOLD=2
FRAUD_ACCOUNT_AGE_DAYS=14
FRAUD_PENALTY_THRESHOLD=0.5
FRAUD_PENALTY_WEIGHT=0.2

# SLA & routing (seconds)
SLA_SAFETY_SECONDS=3600
SLA_DEFAULT_SECONDS=86400

# Max concurrent dispute resolutions when running the evaluation harness.
EVAL_CONCURRENCY=3
